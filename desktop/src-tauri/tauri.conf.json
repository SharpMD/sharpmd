{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SharpMD",
  "version": "2.92.0",
  "identifier": "app.sharpmd.desktop",
  "build": { "frontendDist": "../shell" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SharpMD",
    "copyright": "SharpMD",
    "category": "Productivity",
    "shortDescription": "Markdown editor",
    "longDescription": "SharpMD, the Markdown editor: the same app as sharpmd.app, with your folders and files saved straight to disk.",
    "homepage": "https://sharpmd.app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdx", "mkd", "mdown"], "name": "Markdown", "description": "Markdown document", "role": "Editor", "mimeType": "text/markdown" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": { "minimumSystemVersion": "10.15", "signingIdentity": "-" }
  }
}
